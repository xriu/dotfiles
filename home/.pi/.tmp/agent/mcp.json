{
    "settings": {
        "jev": {
            "semanticSearch": true,
            "allowedServers": [
                "aws-knowledge",
                "aws-infrastructure-as-code",
                "aws-mcp",
                "open-computer-use"
            ]
        }
    },
    "mcpServers": {
        "superlogical": {
            "url": "https://www.superlogical.com/rex/community-mcp"
        },
        "executor": {
            "url": "http://127.0.0.1:4312/mcp"
        },
        "athena": {
            "url": "https://mcp-gateway.launchmetrics.com/athena",
            "description": "Launchmetrics Athena: Jira issues and knowledge retrieval"
        },
        "github": {
            "url": "https://api.githubcopilot.com/mcp/",
            "auth": "bearer",
            "bearerToken": "!gh auth token"
        },
        "computer": {
            "command": "cua-driver",
            "args": ["mcp"]
        },
        "aws-knowledge": {
            "type": "http",
            "url": "https://knowledge-mcp.global.api.aws"
        },
        "aws-infrastructure-as-code": {
            "command": "uvx",
            "args": ["awslabs.aws-iac-mcp-server@latest"],
            "env": {
                "FASTMCP_LOG_LEVEL": "ERROR"
            }
        },
        "aws-mcp": {
            "command": "uvx",
            "timeout": 100000,
            "transport": "stdio",
            "args": [
                "mcp-proxy-for-aws@latest",
                "https://aws-mcp.us-east-1.api.aws/mcp",
                "--metadata"
            ],
            "env": {
                "AWS_PROFILE": "sre-ops"
            }
        },
        "open-computer-use": {
            "type": "local",
            "command": "open-computer-use",
            "args": ["mcp"],
            "timeout": 60000
        }
    }
}
