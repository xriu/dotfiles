{
    "settings": {
        "jev": {
            "semanticSearch": true,
            "allowedServers": ["computer"]
        }
    },
    "mcpServers": {
        "computer": {
            "type": "local",
            "command": "open-computer-use",
            "args": ["mcp"],
            "enabled": true,
            "timeout": 60000
        },
        "aws-mcp": {
            "command": "uvx",
            "args": [
                "mcp-proxy-for-aws@latest",
                "https://aws-mcp.us-east-1.api.aws/mcp"
            ]
        }
    }
}
