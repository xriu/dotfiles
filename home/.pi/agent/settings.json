{
    "lastChangelogVersion": "0.82.1",
    "defaultModel": "qwen3.8-max-preview",
    "defaultProjectTrust": "always",
    "defaultProvider": "xriu-alibaba2",
    "defaultThinkingLevel": "high",
    "extensions": ["~/dotfiles/home/.pi/agent/extensions"],
    "packages": [
        "npm:pi-mcp-adapter",
        {
            "source": "npm:@plannotator/pi-extension",
            "skills": []
        },
        "npm:@ff-labs/pi-fff",
        "npm:pi-lens",
        "npm:pi-rewind",
        "npm:pi-thinking-steps",
        "npm:pi-web-access",
        "npm:pi-powerline-footer"
    ],
    "enableInstallTelemetry": true,
    "httpIdleTimeoutMs": 120000,
    "showCacheMissNotices": true,
    "theme": "dark",
    "compaction": {
        "reserveTokens": 24000,
        "keepRecentTokens": 40000
    },
    "powerline": {
        "welcome": false,
        "layout": {
            "left": [
                "model",
                "thinking",
                "shell_mode",
                "path",
                "context_pct",
                "cost"
            ],
            "secondary": ["git"]
        }
    }
}
