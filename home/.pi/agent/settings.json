{
  "lastChangelogVersion": "0.81.1",
  "defaultModel": "moonshotai/kimi-k3",
  "defaultProjectTrust": "always",
  "defaultProvider": "lm-openrouter",
  "defaultThinkingLevel": "xhigh",
  "extensions": [
    "~/dotfiles/home/.pi/agent/extensions"
  ],
  "packages": [
    "npm:pi-mcp-adapter",
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": []
    },
    "npm:@aliou/pi-guardrails",
    "npm:@ff-labs/pi-fff",
    "npm:@pi-stef/figma",
    "npm:pi-lens",
    "npm:pi-rewind",
    "npm:pi-thinking-steps",
    "npm:pi-web-access"
