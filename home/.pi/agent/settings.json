{
    "lastChangelogVersion": "0.84.4",
    "defaultModel": "google/gemini-3.8-flash",
    "defaultProjectTrust": "always",
    "defaultProvider": "lm-openrouter",
    "defaultThinkingLevel": "max",
    "hideThinkingBlock": true,
    "quietStartup": true,
    "extensions": ["~/dotfiles/home/.pi/agent/extensions"],
    "packages": [
        "git:github.com/dmmulroy/pi-mcp",
        {
            "source": "npm:@plannotator/pi-extension",
            "skills": []
        },
        "npm:@dietrichgebert/ponytail",
        "npm:@ff-labs/pi-fff",
        "npm:@juicesharp/rpiv-todo",
        "npm:@nicknisi/pi-cloak",
        "npm:@tintinweb/pi-subagents",
        "npm:pi-clarify",
        "npm:pi-powerline-footer",
        "npm:pi-rewind",
        "npm:pi-web-access"
    ],
    "enabledModels": [
        "lm-openrouter/anthropic/claude-fable-5.1",
        "lm-openrouter/anthropic/claude-sonnet-5",
        "lm-openrouter/deepseek/deepseek-v4-flash-0731:exacto",
        "lm-openrouter/google/gemini-3.8-flash",
        "lm-openrouter/meta/muse-spark-1.3",
        "lm-openrouter/moonshotai/kimi-k3",
        "lm-openrouter/openai/gpt-5.6-luna",
        "lm-openrouter/openai/gpt-5.6-sol",
        "lm-openrouter/qwen/qwen3.8-flash",
        "lm-openrouter/x-ai/grok-4.6",
        "lm-openrouter/z-ai/glm-5.3-flash",
        "openrouter/openrouter/free",
        "xriu-opencode-anthropic/qwen3.8-flash",
        "xriu-opencode-anthropic/qwen3.8-max",
        "xriu-opencode-openai/deepseek-v4-flash",
        "xriu-opencode-openai/deepseek-v4-pro",
        "xriu-opencode-openai/glm-5.3-flash",
        "xriu-opencode-openai/kimi-k3",
        "xriu-opencode-openai/mimo-v2.5",
        "xriu-opencode-openai/mimo-v2.5-pro"
    ],
    "customHeader": {
        "skillsMode": true
    },
    "enableInstallTelemetry": true,
    "compaction": {
        "enabled": true,
        "reserveTokens": 800000
    },
    "httpIdleTimeoutMs": 120000,
    "showCacheMissNotices": true,
    "theme": "dark",
    "treeFilterMode": "no-tools",
    "powerline": {
        "welcome": false,
        "fixedEditor": false,
        "layout": {
            "left": [
                "model",
                "thinking",
                "shell_mode",
                "path",
                "context_pct",
                "cost"
            ],
            "secondary": ["git"]
        }
    }
}
