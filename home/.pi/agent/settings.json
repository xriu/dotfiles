{
    "lastChangelogVersion": "1.0.0",
    "defaultProvider": "openrouter",
    "defaultModel": "openai/gpt-6-luna",
    "enabledModels": ["openrouter/**", "opencode-go/deepseek-v4.1-flash"],
    "defaultProjectTrust": "always",
    "defaultThinkingLevel": "max",
    "defaultTools": ["+codemode"],
    "hideThinkingBlock": true,
    "quietStartup": true,
    "extensions": ["~/dotfiles/home/.pi/agent/extensions"],
    "packages": [
        "ssh://git@github.com/Launchmetrics/LM-AI@main",
        {
            "source": "ssh://git@github.com/xriu/pi-extensions@main",
            "extensions": [
                "extensions/pi/custom-header/**",
                "extensions/pi/permission-gate/**",
                "extensions/pi/mermaid/**"
            ]
        },
        "npm:@dietrichgebert/ponytail",
        "npm:@ff-labs/pi-fff",
        "npm:@juicesharp/rpiv-todo",
        "npm:@nicknisi/pi-cloak",
        "npm:@tintinweb/pi-subagents",
        "npm:pi-clarify",
        "npm:pi-powerline-footer",
        "npm:pi-rewind",
        "npm:pi-web-access"
    ],
    "customHeader": {
        "skillsMode": true
    },
    "tuiMode": "fullscreen",
    "enableInstallTelemetry": true,
    "httpIdleTimeoutMs": 120000,
    "showCacheMissNotices": true,
    "theme": "dark",
    "treeFilterMode": "no-tools",
    "powerline": {
        "welcome": false,
        "fixedEditor": false,
        "layout": {
            "left": [
                "model",
                "thinking",
                "shell_mode",
                "path",
                "context_pct",
                "cost"
            ],
            "secondary": ["git"]
        }
    }
}
