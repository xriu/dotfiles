{
  "lastChangelogVersion": "0.80.6",
  "packages": [
    "npm:pi-bash-live-view",
    "npm:pi-design-deck",
    "npm:pi-interview",
    "npm:pi-lens",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    "npm:pi-powerline-footer",
    "npm:pi-review-loop",
    "npm:pi-rewind",
    "npm:pi-slop-review",
    "npm:pi-smart-fetch",
    "npm:pi-fusion"
  ],
  "extensions": [
    "~/dotfiles/home/.pi/agent/extensions"
  ],
  "defaultProvider": "lm-openrouter",
  "defaultModel": "deepseek/deepseek-v4-pro",
  "defaultThinkingLevel": "max",
  "defaultProjectTrust": "always",
  "treeFilterMode": "no-tools",
  "theme": "dark",
  "compaction": {
    "reserveTokens": 820000,
    "keepRecentTokens": 20000
  },
  "reviewerLoop": {
    "maxIterations": 3,
    "autoTrigger": true,
    "freshContext": true,
    "reviewPrompt": "template:double-check"
  },
  "showCacheMissNotices": true,
  "followUpMode": "all",
  "steeringMode": "all",
  "httpIdleTimeoutMs": 120000,
  "enableInstallTelemetry": true
}