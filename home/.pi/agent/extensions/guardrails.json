{
    "permissionGate": {
        "allowedPatterns": [
            { "pattern": "^aws .*\\bdescribe", "regex": true },
            { "pattern": "^aws .*\\blist", "regex": true },
            { "pattern": "^aws .*\\bget", "regex": true }
        ],
        "autoDenyPatterns": [
            { "pattern": "dd " },
            { "pattern": "diskutil " },
            { "pattern": "git push " },
            { "pattern": "git reset --hard " },
            { "pattern": "mkfs " },
            { "pattern": "npm publish " },
            { "pattern": "rm -rf /*" },
            { "pattern": "rm -rf /" },
            { "pattern": "rm -rf ." },
            { "pattern": "rm -rf $HOME" },
            { "pattern": "rm -rf ~" },
            { "pattern": "sudo rm -rf " },
            { "pattern": "terraform apply " },
            { "pattern": "terraform destroy " },
            { "pattern": "aws " }
        ]
    },
    "policies": {
        "rules": [
            {
                "id": "sensitive-files",
                "name": "Sensitive files",
                "patterns": [
                    { "pattern": ".env*" },
                    { "pattern": "config/credentials.json" },
                    { "pattern": "secrets/**" },
                    { "pattern": "~/.aws/**" },
                    { "pattern": "~/.ssh/**" }
                ],
                "protection": "noAccess",
                "onlyIfExists": true
            },
            {
                "id": "generated-and-metadata-directories",
                "name": "Generated and metadata directories",
                "patterns": [
                    { "pattern": ".git" },
                    { "pattern": ".git/**" },
                    { "pattern": "node_modules" },
                    { "pattern": "node_modules/**" }
                ],
                "protection": "noAccess",
                "onlyIfExists": true
            }
        ]
    }
}
