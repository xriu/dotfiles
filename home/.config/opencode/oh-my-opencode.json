{
	"$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/refs/heads/dev/assets/oh-my-opencode.schema.json",
	"sisyphus_agent": {
		"disabled": false,
		"default_builder_enabled": false,
		"planner_enabled": true,
		"replace_plan": true
	},
	"hashline_edit": true,
	"disabled_mcps": [],
	"agents": {
		"prometheus": {
			"model": "opencode-go-openai/deepseek-v4-pro",
			"variant": "high"
		},
		"metis": {
			"model": "opencode-go-openai/deepseek-v4-pro",
			"variant": "high"
		},
		"atlas": {
			"model": "opencode-go-openai/deepseek-v4-flash",
			"variant": "medium"
		},
		"sisyphus": {
			"model": "opencode-go-anthropic/minimax-m3"
		},
		"sisyphus-junior": {
			"model": "opencode-go-anthropic/minimax-m3"
		},
		"hephaestus": {
			"model": "opencode-go-openai/deepseek-v4-flash"
		},
		"momus": {
			"model": "opencode-go-openai/deepseek-v4-pro",
			"variant": "xhigh"
		},
		"oracle": {
			"model": "opencode-go-openai/deepseek-v4-pro",
			"variant": "high"
		},
		"librarian": {
			"model": "opencode-go-openai/deepseek-v4-flash"
		},
		"explore": {
			"model": "opencode-go-openai/kimi-k2.7-code"
		},
		"multimodal-looker": {
			"model": "opencode-go-openai/deepseek-v4-flash",
			"variant": "medium"
		},
		"build": {
			"model": "opencode-go-anthropic/minimax-m3"
		},
		"plan": {
			"model": "opencode-go-anthropic/minimax-m3"
		}
	},
	"categories": {
		"ultrabrain": {
			"model": "opencode-go-openai/deepseek-v4-pro",
			"variant": "xhigh"
		},
		"deep": {
			"model": "opencode-go-openai/deepseek-v4-pro",
			"variant": "medium"
		},
		"artistry": {
			"model": "opencode-go-openai/glm-5.2",
			"variant": "high"
		},
		"unspecified-high": {
			"model": "opencode-go-openai/deepseek-v4-flash",
			"variant": "high"
		},
		"unspecified-low": {
			"model": "opencode-go-openai/deepseek-v4-flash",
			"variant": "medium"
		},
		"visual-engineering": {
			"model": "opencode-go-openai/glm-5.2",
			"variant": "high"
		},
		"quick": {
			"model": "opencode-go-openai/mimo-v2.5"
		},
		"writing": {
			"model": "opencode-go-openai/mimo-v2.5"
		}
	},
	"tmux": {
		"enabled": true,
		"layout": "main-vertical",
		"main_pane_size": 60,
		"main_pane_min_width": 120,
		"agent_pane_min_width": 40
	},
	"browser_automation_engine": {
		"provider": "agent-browser"
	}
}
