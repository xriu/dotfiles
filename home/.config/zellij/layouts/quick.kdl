ui {
  pane_frames {
    rounded_corners true
    hide_session_name true
  }
}

layout {
  cwd "$HOME"

  default_tab_template {
    pane size=1 borderless=true {
      plugin location="tab-bar"
    }
    children
    pane size=1 borderless=true {
      plugin location="status-bar"
    }
  }

  tab name="btop" {
    pane command="btop" borderless=true name="xavier.riu"
  }
  tab name="dotfiles" {
    pane cwd="$HOME/dotfiles" borderless=true name="dotfiles"
  }
  tab name="workspace" {
    pane split_direction="vertical" {
      pane cwd="$HOME/Personal" name="Personal"
      pane cwd="$HOME/Develop" name="Develop"
    }
    pane split_direction="vertical" {
      pane cwd="$HOME/.bb" name=".bb"
      pane cwd="/tmp" name="tmp"
    }
  }
}
