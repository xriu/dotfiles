{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "0",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "0",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "true",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet[1m]",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(aws * describe*)",
      "Bash(aws * list*)",
      "Bash(aws * get*)"
    ],
    "deny": [
      "AskUserQuestion",
      "Bash(aws *)",
      "Bash(dd *)",
      "Bash(diskutil *)",
      "Bash(git reset --hard *)",
      "Bash(mkfs *)",
      "Bash(npm publish *)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "PushNotification",
      "Read(./.env*)",
      "Read(./config/credentials.json)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "ReportFindings"
    ],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude/"
    ]
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "enableWorkflows": true,
  "workflowSizeGuideline": "large",
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/dotfiles/home/.claude/status-line.sh"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-code-plugins": true,
    "frontend-design@claude-plugins-official": true,
    "plugin-dev@claude-code-plugins": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "subagentPromptCacheTtl": "1h",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "ultracode": false,
  "fastMode": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "hasCompletedOnboarding": true
}
