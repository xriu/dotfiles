    "attribution": {
        "commit": "",
        "pr": ""
    },
    "permissions": {
        "allow": [],
        "deny": [
            "Bash(dd *)",
            "Bash(diskutil *)",
            "Bash(git push *)",
            "Bash(git reset --hard *)",
            "Bash(mkfs *)",
            "Bash(npm publish *)",
            "Bash(rm -rf /*)",
            "Bash(rm -rf /)",
            "Bash(rm -rf .*)",
            "Bash(rm -rf $HOME*)",
            "Bash(rm -rf ~*)",
            "Bash(sudo rm -rf *)",
            "Bash(terraform apply *)",
            "Bash(terraform destroy *)",
            "Read(./.env*)",
            "Read(./config/credentials.json)",
            "Read(./secrets/**)",
            "Read(~/.aws/**)",
            "Read(~/.ssh/**)",
            "AskUserQuestion",
            "CronCreate",
            "CronDelete",
            "CronList",
            "DesignSync",
            "EnterPlanMode",
            "ExitPlanMode",
            "NotebookEdit",
            "PushNotification",
            "RemoteTrigger",
            "ReportFindings",
            "ScheduleWakeup",
            "SendMessage"
        ],
        "ask": [],
